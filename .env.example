# =============================================================================
# Licora - License Server Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before running the server.
# All variables listed here are required unless marked as optional.
# =============================================================================

# --- Required ---

# Password for the admin dashboard and internal API access.
# This is the only authentication mechanism — use a strong, unique password.
# Do NOT use the default value in production.
DASHBOARD_PASSWORD=change-me-to-a-strong-password

# --- Optional (sensible defaults provided) ---

# Port the server listens on.
# Default: 3000
# PORT=3000

# Host address to bind to. Use 0.0.0.0 for Docker/external access.
# Default: 0.0.0.0
# HOST=0.0.0.0

# Path to the SQLite database file.
# Default: ./data/licenses.db
# DATABASE_PATH=./data/licenses.db

# Prefix for generated license keys (e.g., NSTK for "NSTK-XXXX-XXXX-XXXX").
# Default: LICENSE
# LICENSE_KEY_PREFIX=LICENSE

# Product name displayed in the dashboard and license records.
# Default: NS Toolkit
# PRODUCT_NAME=NS Toolkit
